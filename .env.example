# Exemple neutre (remplacez par vos chemins locaux)
OLLAMA_BASE_URL=http://localhost:11434
ALLOWED_ROOTS=C:/chemin/vers/iris-mcp-server,C:/chemin/vers/vault

# Outils web (v0.5.0) : allowlist d'hotes, optionnelle.
# Vide ou absente = tout hote public autorise (les IP privees restent refusees).
# Renseignee = seuls ces hotes et leurs sous-domaines passent. Voir docs/securite-web.md.
# WEB_ALLOWED_HOSTS=wikipedia.org,duckduckgo.com,github.com

# Zone reservee RAG (F5 22/10) : sans cette variable, includeReserved=true est ignore.
# IRIS_ALLOW_RESERVED=1

# Motifs Zone A / reserved (depot prive) — requis pour les outils RAG (fail-closed si absent).
# ZONE_A_PATTERNS_FILE=C:/chemin/vers/zone-a-patterns.json

# Optionnel (futur)
# ANTHROPIC_API_KEY=
# BRAVE_API_KEY=   # recherche web indexee (web-search-ddg-v1 ne couvre pas tout le web)
