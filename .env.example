# Auth token simple pour acces local V1 (placeholder, a generer)
MCP_AUTH_TOKEN=replace_with_a_secure_random_token

# Port d'ecoute du serveur MCP (V1)
MCP_PORT=3333

# Port d'ecoute API REST (V2)
API_PORT=3334

# Sandbox filesystem (chemin du dossier accessible par le tool filesystem V1)
FILESYSTEM_SANDBOX_PATH=./sandbox

# Endpoint Ollama local (V2)
OLLAMA_BASE_URL=http://localhost:11434

# URL Cloudflare tunnel (V2 distant)
CLOUDFLARE_TUNNEL_URL=
