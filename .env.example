# Exemple neutre (remplacez par vos chemins locaux)
OLLAMA_BASE_URL=http://localhost:11434
# Lot O (ADR-0013/0014) : si Ollama manque, embeddings au format OpenAI vers un moteur de secours (pas une 3e instance Iris),
# accepte seulement s'il redonne le vecteur de reference de nomic-embed-text. Secours par le llama.cpp de Hermes REPORTE
# (16/11 : son serveur exige une cle). Sans aucun moteur : rag-hybrid-v1 cherche par mots exacts (mode degrade).
# IRIS_LLM_SECOURS_URL=http://127.0.0.1:18434
# IRIS_LLM_SECOURS_HORS_LOOPBACK=1
# Ollama : loopback seulement par defaut (127.0.0.1, localhost, ::1), sans identifiants ni chemin reseau.
# Pour viser une autre machine, choix explicite (a eviter) :
# IRIS_OLLAMA_HORS_LOOPBACK=1
# ollama-chat-v1 : 2 appels en vol, 4 en attente, le reste refuse (isError).
# RAG (rag-query-v1, rag-search-v2, rag-hybrid-v1) : QDRANT_URL et OLLAMA_BASE_URL en loopback seulement.
# Pas de redirection, reponses plafonnees (Qdrant 16 Mio, Ollama 2 Mio). La cle Qdrant ne part que vers la base Qdrant validee.
# Autre machine, choix explicite (a eviter) : IRIS_QDRANT_HORS_LOOPBACK=1 (Qdrant) ou IRIS_OLLAMA_HORS_LOOPBACK=1 (Ollama).
# connectivite-v1 : cache partage entre processus dans le dossier temporaire du compte (1 Mio par minute au plus,
# 15 s apres un echec). Dossier different (optionnel) : IRIS_CONNECTIVITE_DIR=<dossier>
ALLOWED_ROOTS=C:/chemin/vers/iris-mcp-server,C:/chemin/vers/vault

# Outils web (v0.5.0) : allowlist d'hotes, optionnelle.
# Vide ou absente = tout hote public autorise (les IP privees restent refusees).
# Renseignee = seuls ces hotes et leurs sous-domaines passent. Voir docs/securite-web.md.
# WEB_ALLOWED_HOSTS=wikipedia.org,duckduckgo.com,github.com

# Zone reservee RAG (F5 22/10) : sans cette variable, includeReserved=true est ignore.
# IRIS_ALLOW_RESERVED=1

# Motifs Zone A / reserved (depot prive) — requis pour les outils RAG (fail-closed si absent).
# ZONE_A_PATTERNS_FILE=C:/chemin/vers/zone-a-patterns.json

# Optionnel
# ANTHROPIC_API_KEY=
# BRAVE_API_KEY=          # web-search-v2 : index Brave (ADR-0011)
# IRIS_SEARXNG_URL=http://127.0.0.1:8080   # web-search-v2 : SearXNG labo loopback seulement
# Reveil a la demande (optionnel) : SearXNG eteint -> Iris lance « <docker> start <conteneur> » puis relance la recherche.
# IRIS_SEARXNG_CONTENEUR=<nom du conteneur SearXNG>
# IRIS_DOCKER_EXE=<chemin absolu de docker.exe>

# Journal des echecs des moteurs (lot O, ADR-0014) : une ligne JSON par echec, champs fixes seulement
# (date, outil, etape, cause, moteur, tentative, duree, code HTTP). Jamais de texte, d URL, de cle ni de prompt.
# Par defaut : dossier d etat de l utilisateur (%LOCALAPPDATA%\iris-mcp), 1 Mio puis rotation. Couper : IRIS_JOURNAL_MOTEURS=0
# IRIS_JOURNAL_MOTEURS_DIR=C:\chemin\local\journal
